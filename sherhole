#!/usr/bin/env python3

import shutil
import subprocess
import sys
from datetime import datetime
from pathlib import Path


OUTPUT_BASE = Path.home() / "Desktop" / "recon" / "sherhole"


def check_command(command):
    if not shutil.which(command):
        print(f"[!] {command} was not found in PATH.")
        print(f"    Install it before using SherHole.")
        sys.exit(1)


def create_run_directory():
    OUTPUT_BASE.mkdir(parents=True, exist_ok=True)

    timestamp = datetime.now().strftime("%Y-%m-%d_%H-%M-%S")
    run_dir = OUTPUT_BASE / timestamp
    run_dir.mkdir(parents=True, exist_ok=True)

    return run_dir


def run_sherlock(username, run_dir):
    output_file = run_dir / f"sherlock_{username}.txt"

    print("\n" + "=" * 60)
    print(f"[*] Sherlock: {username}")
    print("=" * 60)
    print("[*] Searching...\n")

    command = [
        "sherlock",
        username,
        "--output",
        str(output_file),
    ]

    try:
        result = subprocess.run(command)

        print("\n" + "-" * 60)

        if result.returncode == 0:
            print("[+] Sherlock finished.")
        else:
            print(f"[!] Sherlock exited with code {result.returncode}")

        print(f"[+] Results saved to:")
        print(f"    {output_file}")

    except KeyboardInterrupt:
        print("\n[!] Sherlock interrupted by user.")

        try:
            subprocess.run(
                ["pkill", "-INT", "-f", f"sherlock {username}"],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
            )
        except Exception:
            pass


def run_holehe(email, run_dir):
    safe_email = email.replace("@", "_at_").replace("/", "_")
    output_file = run_dir / f"holehe_{safe_email}.txt"

    print("\n" + "=" * 60)
    print(f"[*] Holehe: {email}")
    print("=" * 60)
    print("[*] Searching...\n")

    command = ["holehe", email]

    try:
        with open(output_file, "w", encoding="utf-8") as outfile:

            process = subprocess.Popen(
                command,
                stdout=subprocess.PIPE,
                stderr=subprocess.STDOUT,
                text=True,
                bufsize=1,
            )

            for line in process.stdout:
                print(line, end="")
                outfile.write(line)
                outfile.flush()

            process.wait()

        print("\n" + "-" * 60)

        if process.returncode == 0:
            print("[+] Holehe finished.")
        else:
            print(f"[!] Holehe exited with code {process.returncode}")

        print(f"[+] Results saved to:")
        print(f"    {output_file}")

    except KeyboardInterrupt:
        print("\n[!] Holehe interrupted.")

        try:
            process.terminate()
            process.wait(timeout=3)
        except Exception:
            try:
                process.kill()
            except Exception:
                pass


def get_input(prompt):
    while True:
        value = input(prompt).strip()

        if value:
            return value

        print("[!] Please enter a value.")


def main():

    print()
    print("=" * 60)
    print("                    SHERHOLE")
    print("             Sherlock + Holehe")
    print("=" * 60)
    print()

    check_command("sherlock")
    check_command("holehe")

    print("1) Sherlock username")
    print("2) Holehe email")
    print("3) Both")
    print("4) Exit")
    print()

    choice = input("Choice: ").strip()

    if choice == "4":
        return

    if choice not in ("1", "2", "3"):
        print("[!] Invalid choice.")
        return

    run_dir = create_run_directory()

    print()
    print(f"[+] Results directory:")
    print(f"    {run_dir}")

    if choice in ("1", "3"):
        print()
        username = get_input("Username: ")

        run_sherlock(username, run_dir)

    if choice in ("2", "3"):
        print()
        email = get_input("Email: ")

        run_holehe(email, run_dir)

    print()
    print("=" * 60)
    print("                    COMPLETE")
    print("=" * 60)
    print(f"Results saved in:")
    print(f"{run_dir}")
    print()


if __name__ == "__main__":
    main()
